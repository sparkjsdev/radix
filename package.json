    "escape-string-regexp": "^4.0.0",
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1",
    "espree": "^10.4.0",
    "esquery": "^1.7.0",
    "esrecurse": "^4.3.0",
    "estraverse": "^5.3.0",
    "esutils": "^2.0.3",
    "eventemitter3": "^4.0.7",
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "fast-levenshtein": "^2.0.6",
    "fdir": "^6.5.0",
    "fflate": "^0.8.3",
    "file-entry-cache": "^8.0.0",
    "find-up": "^5.0.0",
    "flat-cache": "^4.0.1",
    "flatted": "^3.4.4",
    "follow-redirects": "^1.16.1",
    "fsevents": "^2.3.3",
    "function-bind": "^1.1.2",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "glob-parent": "^6.0.2",
    "gopd": "^1.2.0",
    "has-flag": "^4.0.0",
    "has-symbols": "^1.1.0",
    "hasown": "^2.0.4",
    "he": "^1.2.0",
    "html-encoding-sniffer": "^3.0.0",
    "http-proxy": "^1.18.1",
    "iconv-lite": "^0.6.3",
    "ignore": "^5.3.2",
    "import-fresh": "^3.3.1",
    "imurmurhash": "^0.1.4",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "isexe": "^2.0.0",
    "js-yaml": "^4.3.2",
    "json-buffer": "^3.0.1",
    "json-schema-traverse": "^0.4.1",
    "json-stable-stringify-without-jsonify": "^1.0.1",
    "keyv": "^4.5.4",
    "levn": "^0.4.1",
    "locate-path": "^6.0.0",
    "lodash.merge": "^4.6.2",
    "math-intrinsics": "^1.1.0",
    "meshoptimizer": "^1.1.1",
    "mime": "^1.6.0",
    "minimatch": "^3.1.5",
    "minimist": "^1.2.8",
    "ms": "^2.1.3",
    "natural-compare": "^1.4.0",
    "object-inspect": "^1.13.4",
    "opener": "^1.5.2",
    "optionator": "^0.9.4",
    "p-limit": "^3.1.0",
    "p-locate": "^5.0.0",
    "parent-module": "^1.0.1",
    "path-exists": "^4.0.0",
    "path-key": "^3.1.1",
    "picomatch": "^4.0.7",
    "portfinder": "^1.0.38",
    "prelude-ls": "^1.2.1",
    "punycode": "^2.3.1",
    "qs": "^6.16.1",
    "requires-port": "^1.0.0",
    "resolve-from": "^4.0.0",
    "safe-buffer": "^5.1.2",
    "safer-buffer": "^2.1.2",
    "secure-compare": "^3.0.1",
    "semver": "^7.8.5",
    "shebang-command": "^2.0.0",
    "shebang-regex": "^3.0.0",
    "side-channel": "^1.1.1",
    "side-channel-list": "^1.0.1",
    "side-channel-map": "^1.0.1",
    "side-channel-weakmap": "^1.0.2",
    "strip-json-comments": "^3.1.1",
    "supports-color": "^7.2.0",
    "tinyglobby": "^0.2.17",
    "ts-api-utils": "^2.5.0",
    "type-check": "^0.4.0",
    "union": "^0.5.0",
    "uri-js": "^4.4.1",
    "url-join": "^4.0.1",
    "whatwg-encoding": "^2.0.0",
    "which": "^2.0.2",
