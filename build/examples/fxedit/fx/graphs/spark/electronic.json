{
  "version": 1,
  "name": "electronic",
  "description": "Circuit lines from a folding fractal run over the scan, which dims and tints blue-teal by height, while the top wobbles side to side. The fractal is one macro node (a loop); the rest is ordinary nodes.",
  "source": { "name": "Spark examples: splat-shader-effects (Electronic)", "url": "https://github.com/sparkjsdev/spark/tree/main/examples/splat-shader-effects", "license": "MIT" },
  "nodes": {
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "time": { "type": "input.time" },
    "intensity": { "type": "input.float", "inputs": { "value": 0.8 } },
    "split": { "type": "math.vec3Split" },
    "circuit": { "type": "field.foldFractal", "inputs": { "scale": 0.6, "speed": 0.5, "width": 0.5 }, "note": "1 on a circuit line" },
    "lines": { "type": "math.mul", "inputs": { "b": 1.3 } },
    "tintRed": { "type": "math.mul", "inputs": { "b": 0.3 } },
    "tint": { "type": "math.vec3Combine", "inputs": { "y": 0.5, "z": 0.7 } },
    "tintAmount": { "type": "math.vec3Scale" },
    "light": { "type": "math.vec3Add" },
    "color": { "type": "color.blend", "options": { "mode": "multiply" } },
    "base": { "type": "math.add", "inputs": { "b": 0.3 } },
    "dim": { "type": "math.mix", "inputs": { "a": 1 }, "note": "Dim the body, keep the lines" },
    "dimClamp": { "type": "math.clamp", "inputs": { "low": 0, "high": 1 } },
    "top": { "type": "math.smoothstep", "inputs": { "low": 0.2, "high": 0.8 }, "note": "Only the top wobbles" },
    "wobble": { "type": "math.sine", "inputs": { "frequency": 0.318, "amplitude": 0.2 } },
    "angle": { "type": "math.mul" },
    "turn": { "type": "math.rotate", "inputs": { "axis": [0, 0, 1], "pivot": [0, 0.2, 0] } },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "center.value", "to": "split.v" },
    { "from": "center.value", "to": "circuit.position" },
    { "from": "circuit.mask", "to": "lines.a" },
    { "from": "split.y", "to": "tintRed.a" },
    { "from": "tintRed.value", "to": "tint.x" },
    { "from": "tint.value", "to": "tintAmount.v" },
    { "from": "intensity.value", "to": "tintAmount.s" },
    { "from": "tintAmount.value", "to": "light.a" },
    { "from": "lines.value", "to": "light.b" },
    { "from": "rgb.value", "to": "color.base" },
    { "from": "light.value", "to": "color.color" },
    { "from": "intensity.value", "to": "color.amount" },
    { "from": "color.value", "to": "out.rgb" },
    { "from": "lines.value", "to": "base.a" },
    { "from": "base.value", "to": "dim.b" },
    { "from": "intensity.value", "to": "dim.t" },
    { "from": "dim.value", "to": "dimClamp.x" },
    { "from": "dimClamp.value", "to": "out.opacity" },
    { "from": "split.y", "to": "top.x" },
    { "from": "time.seconds", "to": "wobble.x" },
    { "from": "top.value", "to": "angle.a" },
    { "from": "wobble.value", "to": "angle.b" },
    { "from": "center.value", "to": "turn.point" },
    { "from": "angle.value", "to": "turn.angle" },
    { "from": "turn.value", "to": "out.center" }
  ],
  "params": {
    "Intensity": "intensity.value",
    "Circuit scale": "circuit.scale",
    "Line width": "circuit.width",
    "Flow speed": "circuit.speed",
    "Wobble": "wobble.amplitude"
  }
}
