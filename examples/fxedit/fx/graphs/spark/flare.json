{
  "version": 1,
  "name": "flare",
  "description": "Splats lift off, whiten and swarm into a looping point above the scan, then fall back. A random number per splat shifts a sine of time, so each splat leaves on its own schedule; a moving target decides where it goes.",
  "source": { "name": "Spark examples: splat-shader-effects (Flare)", "url": "https://github.com/sparkjsdev/spark/tree/main/examples/splat-shader-effects", "license": "MIT" },
  "nodes": {
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "opacity": { "type": "input.opacity" },
    "time": { "type": "input.time" },
    "random": { "type": "field.hash3", "note": "A different number per splat" },
    "pick": { "type": "math.vec3Split" },
    "shift": { "type": "math.mul", "inputs": { "b": 6.28 } },
    "when": { "type": "math.add", "note": "Time, shifted per splat" },
    "cycle": { "type": "math.sine", "inputs": { "frequency": 0.159 } },
    "leave": { "type": "math.smoothstep", "inputs": { "low": -1, "high": 0.5 } },
    "away": { "type": "math.pow", "inputs": { "e": 2 }, "note": "0 home, 1 at the target" },
    "fast": { "type": "math.sine", "inputs": { "frequency": 0.318 } },
    "slow": { "type": "math.sine", "inputs": { "frequency": 0.159 } },
    "loop": { "type": "math.vec3Combine", "note": "The target's looping path" },
    "swing": { "type": "math.vec3Scale" },
    "target": { "type": "math.vec3Add", "inputs": { "b": [0, 1.1, 0] } },
    "fly": { "type": "math.vec3Mix" },
    "whiten": { "type": "color.tint", "inputs": { "color": [1, 1, 1], "intensity": 1.2 } },
    "thin": { "type": "math.mix", "inputs": { "b": 0.3 } },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "center.value", "to": "random.position" },
    { "from": "random.value", "to": "pick.v" },
    { "from": "pick.x", "to": "shift.a" },
    { "from": "time.seconds", "to": "when.a" },
    { "from": "shift.value", "to": "when.b" },
    { "from": "when.value", "to": "cycle.x" },
    { "from": "cycle.value", "to": "leave.x" },
    { "from": "leave.value", "to": "away.x" },
    { "from": "time.seconds", "to": "fast.x" },
    { "from": "time.seconds", "to": "slow.x" },
    { "from": "fast.value", "to": "loop.x" },
    { "from": "slow.value", "to": "loop.y" },
    { "from": "fast.value", "to": "loop.z" },
    { "from": "loop.value", "to": "swing.v" },
    { "from": "away.value", "to": "swing.s" },
    { "from": "swing.value", "to": "target.a" },
    { "from": "center.value", "to": "fly.a" },
    { "from": "target.value", "to": "fly.b" },
    { "from": "away.value", "to": "fly.t" },
    { "from": "fly.value", "to": "out.center" },
    { "from": "rgb.value", "to": "whiten.rgb" },
    { "from": "away.value", "to": "whiten.amount" },
    { "from": "whiten.value", "to": "out.rgb" },
    { "from": "opacity.value", "to": "thin.a" },
    { "from": "away.value", "to": "thin.t" },
    { "from": "thin.value", "to": "out.alpha" }
  ],
  "params": {
    "Target": "target.b",
    "Leave early": "leave.low",
    "Swarm width": "fast.amplitude",
    "Swarm height": "slow.amplitude",
    "Glow": "whiten.intensity"
  }
}
