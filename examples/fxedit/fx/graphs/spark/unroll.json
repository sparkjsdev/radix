{
  "version": 1,
  "name": "unroll",
  "description": "Click the scan: it untwists from a tight, inside-out helix and appears from the top down. Rotation by height is the core of every twist deformer; a decay of time since the click relaxes it.",
  "source": { "name": "Spark examples: splat-reveal-effects (Unroll)", "url": "https://github.com/sparkjsdev/spark/tree/main/examples/splat-reveal-effects", "license": "MIT" },
  "nodes": {
    "click": { "type": "input.click" },
    "center": { "type": "input.center" },
    "speed": { "type": "math.mul", "inputs": { "b": 1.2 } },
    "split": { "type": "math.vec3Split" },
    "relax": { "type": "math.decay", "inputs": { "rate": 1 }, "note": "1 at the click, then toward 0" },
    "twistByHeight": { "type": "math.mul", "inputs": { "b": 14 } },
    "twistBase": { "type": "math.sub", "inputs": { "b": 5 } },
    "twist": { "type": "math.mul", "note": "More twist higher up, less as time goes on" },
    "spin": { "type": "math.rotate", "inputs": { "axis": [0, 1, 0] } },
    "flip": { "type": "math.mul", "inputs": { "b": -2 } },
    "factor": { "type": "math.add", "inputs": { "b": 1 }, "note": "1 - 2 decay: starts inside out" },
    "place": { "type": "math.scaleAbout" },
    "grow": { "type": "math.add" },
    "growStart": { "type": "math.sub", "inputs": { "b": 1 } },
    "full": { "type": "math.smoothstep", "inputs": { "low": 0.3, "high": 0.7 } },
    "tiny": { "type": "math.oneMinus" },
    "revealTime": { "type": "math.mul", "inputs": { "b": 0.8 } },
    "reveal": { "type": "math.add" },
    "shown": { "type": "math.greater", "inputs": { "b": 0.8 } },
    "out": { "type": "splat.write", "inputs": { "size": 0.002 } }
  },
  "links": [
    { "from": "click.age", "to": "speed.a" },
    { "from": "center.value", "to": "split.v" },
    { "from": "speed.value", "to": "relax.x" },
    { "from": "split.y", "to": "twistByHeight.a" },
    { "from": "twistByHeight.value", "to": "twistBase.a" },
    { "from": "twistBase.value", "to": "twist.a" },
    { "from": "relax.value", "to": "twist.b" },
    { "from": "center.value", "to": "spin.point" },
    { "from": "twist.value", "to": "spin.angle" },
    { "from": "relax.value", "to": "flip.a" },
    { "from": "flip.value", "to": "factor.a" },
    { "from": "spin.value", "to": "place.point" },
    { "from": "factor.value", "to": "place.factor" },
    { "from": "place.value", "to": "out.center" },
    { "from": "speed.value", "to": "grow.a" },
    { "from": "split.y", "to": "grow.b" },
    { "from": "grow.value", "to": "growStart.a" },
    { "from": "growStart.value", "to": "full.x" },
    { "from": "full.value", "to": "tiny.x" },
    { "from": "tiny.value", "to": "out.sizeMix" },
    { "from": "speed.value", "to": "revealTime.a" },
    { "from": "revealTime.value", "to": "reveal.a" },
    { "from": "split.y", "to": "reveal.b" },
    { "from": "reveal.value", "to": "shown.a" },
    { "from": "shown.value", "to": "out.keep" }
  ],
  "params": {
    "Speed": "speed.b",
    "Twist": "twistByHeight.b",
    "Reveal speed": "revealTime.b"
  }
}
