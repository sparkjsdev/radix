{
  "version": 1,
  "name": "colorWave",
  "description": "Two interfering waves in distance from the start view, times exp(-0.01 r^2), recolor splats by the direction to them (abs of the unit vector), fade their opacity with the wave, and nudge them by 0.02.",
  "nodes": {
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "opacity": { "type": "input.opacity" },
    "time": { "type": "input.time" },
    "wave": { "type": "wl.colorWave" },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "center.value", "to": "wave.position" },
    { "from": "rgb.value", "to": "wave.rgb" },
    { "from": "opacity.value", "to": "wave.opacity" },
    { "from": "time.seconds", "to": "wave.time" },
    { "from": "wave.rgb", "to": "out.rgb" },
    { "from": "wave.alpha", "to": "out.alpha" },
    { "from": "wave.offset", "to": "out.offset" }
  ],
  "params": {
    "Origin": "wave.origin"
  }
}
