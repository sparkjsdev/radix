{
  "version": 1,
  "name": "spotlight",
  "description": "A smooth cone from a lamp toward a target, brightness over attenuation times distance squared, over a 0.25 floor. The lamp hangs above and in front of the scan with a 30 degree cone. Click the scan to aim it.",
  "nodes": {
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "click": { "type": "input.click", "note": "Click to aim" },
    "light": { "type": "wl.spotlight", "inputs": {"lamp": [0, 2.2, 1.6], "fov": 30, "smooth": 8, "brightness": 25, "attenuation": 2.5} },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "center.value", "to": "light.position" },
    { "from": "rgb.value", "to": "light.rgb" },
    { "from": "click.point", "to": "light.target" },
    { "from": "light.rgb", "to": "out.rgb" }
  ],
  "params": {
    "Lamp": "light.lamp",
    "Cone (deg)": "light.fov",
    "Soft edge (deg)": "light.smooth",
    "Brightness": "light.brightness",
    "Attenuation": "light.attenuation"
  }
}
