{
  "version": 1,
  "name": "waves",
  "description": "Height changes by 0.3 sin(dot(p, dir) - t) with dir (-1, 0, 5) normalized, measured from the start view, so a plane wave rolls through the scene.",
  "nodes": {
    "center": { "type": "input.center" },
    "time": { "type": "input.time" },
    "waves": { "type": "wl.waves", "inputs": {"direction": [-1, 0, 5], "amplitude": 0.3} },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "center.value", "to": "waves.position" },
    { "from": "time.seconds", "to": "waves.time" },
    { "from": "waves.offset", "to": "out.offset" }
  ],
  "params": {
    "Direction": "waves.direction",
    "Amplitude": "waves.amplitude",
    "Origin": "waves.origin"
  }
}
