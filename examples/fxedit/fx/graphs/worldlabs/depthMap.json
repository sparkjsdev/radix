{
  "version": 1,
  "name": "depthMap",
  "description": "Each splat's view depth on a log scale from near 0.6 to far 25 picks a color from the torch palette reversed (light near, dark far), and splats are dilated by 0.6 so the map reads as surfaces. Blend 1 is the full effect.",
  "nodes": {
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "camera": { "type": "input.camera" },
    "depth": { "type": "wl.depthColor", "options": {"palette": "torch_reverse"}, "note": "log2 depth between near and far" },
    "show": { "type": "color.blend", "inputs": {"amount": 1}, "options": {"mode": "replace"}, "note": "blend" },
    "out": { "type": "splat.write", "inputs": {"scale": 1.6}, "note": "scale 1 + the 0.6 dilation" }
  },
  "links": [
    { "from": "center.value", "to": "depth.position" },
    { "from": "camera.position", "to": "depth.cameraPosition" },
    { "from": "camera.forward", "to": "depth.cameraForward" },
    { "from": "rgb.value", "to": "show.base" },
    { "from": "depth.value", "to": "show.color" },
    { "from": "show.value", "to": "out.rgb" }
  ],
  "params": {
    "Near": "depth.near",
    "Far": "depth.far",
    "Blend": "show.amount",
    "Dilate": "out.scale"
  }
}
