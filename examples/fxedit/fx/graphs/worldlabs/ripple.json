{
  "version": 1,
  "name": "ripple",
  "description": "Click the scan and a wave runs inward over 3 seconds, its size scaled by the hit point's distance to the camera; splats move along the direction from the hit point and brighten on the crests (at amplitude 0.3, since 1 is a lot on an object).",
  "nodes": {
    "click": { "type": "input.click" },
    "center": { "type": "input.center" },
    "rgb": { "type": "input.rgb" },
    "camera": { "type": "input.camera" },
    "reach": { "type": "field.distance", "note": "Scale: the hit point's distance to the camera" },
    "ripple": { "type": "wl.ripple", "inputs": {"duration": 3, "outward": false, "amplitude": 0.3} },
    "out": { "type": "splat.write" }
  },
  "links": [
    { "from": "click.point", "to": "reach.position" },
    { "from": "camera.position", "to": "reach.point" },
    { "from": "center.value", "to": "ripple.position" },
    { "from": "rgb.value", "to": "ripple.rgb" },
    { "from": "click.point", "to": "ripple.center" },
    { "from": "click.age", "to": "ripple.age" },
    { "from": "reach.value", "to": "ripple.scale" },
    { "from": "ripple.offset", "to": "out.offset" },
    { "from": "ripple.rgb", "to": "out.rgb" }
  ],
  "params": {
    "Duration": "ripple.duration",
    "Amplitude": "ripple.amplitude",
    "Outward": "ripple.outward"
  }
}
